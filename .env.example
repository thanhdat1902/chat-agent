# Whichever key is present wins, OpenAI first. With neither, the app runs on
# deterministic fallbacks and the permission demos still work.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Local file DB by default; point at Turso for a hosted deploy.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
